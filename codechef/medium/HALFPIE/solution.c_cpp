#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    std::cin >> t;
    while (t--) {
        int n;
        cin >> n;
        std::vector < int > arr;
        int sum = 0;
        for (int i = 0; i < n; i++) {
            int num;
            cin >> num;
            sum += num;
            arr.push_back(num);
            
        }
        
        int max_sum = INT_MIN;
        int j = 0;
        for (int i = 1; i < n; i++) {
            int copy_sum_1 = sum - arr[i] - arr[j];
            int new_sum = copy_sum_1 + arr[i]/2 +arr[j]/2;
            max_sum = max(max_sum, new_sum);
            j++;
        }
        std::cout << max_sum << std::endl;
    }

}