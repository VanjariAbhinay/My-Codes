#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    std::cin >> t;
    while (t--) {
        int N;
        int K;
        cin >> N >> K;
        string s;
        cin >> s;
        int count_pairs =0;
        for (int j = 1; j < N; j++) {
            if(s[j-1]==s[j]){
                count_pairs+=1;
            }
        }
        int rem_size = N - count_pairs;
        if(rem_size<=K){
            std::cout << "YES" << std::endl;
        }else{
            std::cout << "NO" << std::endl;
        }

        

    }

}