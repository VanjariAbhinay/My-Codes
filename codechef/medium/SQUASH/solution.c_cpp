#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    std::cin >> t;
    while (t--) {
        int N;
        int K;
        cin >> N >> K;
        string s;
        cin >> s;
        if (N == 1 && K == 1) std::cout << "YES" << std::endl;
        int size=N;
        
        int i =0;
        string ans = "NO";
        for(int j =1;j<N;j++){
            if(size==K){
                ans= "YES";
                break;
            }
            if(s[i]==s[j]){
                size-=1;
            }
            i++;
        }
        std::cout << ans << std::endl;

    }

}