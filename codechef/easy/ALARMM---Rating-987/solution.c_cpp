#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int T;
	cin>>T;
	while(T--)
	{
	    int N;
	    int K;
	    cin>>N>>K;
	    string S;
	    cin>>S;
	    int count=0;
	    int i =0;
	   // while(i < N && S[i] == '0') i += 1;
	    while(i<N){
	        if(S[i]=='1'){
	            i+= K+1;
	            count++;
	        }else{
	            i++;
	        }
	    }
	    std::cout << count << std::endl;
	    
	}
	return 0;

}
